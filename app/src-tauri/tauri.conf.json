{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keepsake",
  "version": "0.1.0",
  "identifier": "dev.keepsake.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter ui dev",
    "beforeBuildCommand": "pnpm --filter ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Keepsake",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../vendor/exiftool/exiftool.exe": "exiftool/exiftool.exe",
      "../../vendor/exiftool/exiftool_files/**": "exiftool/exiftool_files/"
    }
  }
}
